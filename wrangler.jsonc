{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "legal-life",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // workers.devでの動作確認が済んだため、カスタムドメインのみにする
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "legal-life.saka2931.jp", "custom_domain": true }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
    "traces": { "enabled": true, "head_sampling_rate": 1, "persist": true },
    "issues": { "enabled": true }
  },
  "placement": { "region": "aws:ap-northeast-1" },
  // 本番(Neon の production ブランチ。2026/11/28 に切り替え)
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "150eb4cb73ab48c983e0876e001cd0cf" },
    { "binding": "INFRA", "id": "91ba72ad1daa40ee84da8b4f6d4a0916" }
  ],
  // 検証用(Neon の dev ブランチ)。本番の legal-life.saka2931.jp には一切つながない。
  // HYPERDRIVE: service の dev(利用者データ。キャッシュ無効)/ INFRA: infra の dev(お知らせ・フラグの読み取りのみ)。
  // 本番の Hyperdrive(main ブランチ向け)は、切り替え(Phase 7)のときにトップレベルへ追加する。
  "env": {
    "staging": {
      "name": "legal-life-staging",
      "main": ".open-next/worker.js",
      "compatibility_date": "2026-11-01",
      "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
      "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
      // 本番のカスタムドメインを引き継がない(空配列で明示。付け替え事故の防止)
      "routes": [],
      "workers_dev": true,
      "preview_urls": false,
      "vars": { "ENVIRONMENT": "staging", "AUTH_BASE_URL": "https://auth-staging.saka2931.workers.dev" },
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "b5f0397c65ba4652a529eae0f72dc845" },
        { "binding": "INFRA", "id": "3a06473772ea48e1af1d8f620f555bbd" }
      ],
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
        "traces": { "enabled": true, "head_sampling_rate": 1, "persist": true },
        "issues": { "enabled": true }
      },
      "placement": { "region": "aws:ap-northeast-1" }
    }
  }
}
