{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "legal-life",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // workers.devでの動作確認が済んだため、カスタムドメインのみにする
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "legal-life.saka2931.jp", "custom_domain": true }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
    "traces": { "enabled": true, "head_sampling_rate": 1, "persist": true },
    "issues": { "enabled": true }
  },
  "placement": { "region": "aws:ap-northeast-1" }
}
