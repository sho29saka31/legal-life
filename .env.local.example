# Supabase（saka2931-service プロジェクト、sporiveと共有。スキーマはlegal_lifeで分離）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サイトの本番URL（メタデータ・サイトマップ生成に使用）
NEXT_PUBLIC_SITE_URL=https://legal-life.saka2931.jp

# Google Gemini API（AIチャット機能、サーバー専用。/api/chatのみで参照）
GEMINI_API_KEY=

# Resend（メール送信）
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Cloudflare Turnstile（CAPTCHA、任意。未設定時はウィジェット非表示）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google Tag Manager / GA4（アクセス解析）
NEXT_PUBLIC_GTM_CONTAINER_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google OAuth 2.0 クライアントID（Google One Tap用）
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# saka2931-infra（adac/statusと共有）の読み取り専用クライアント
# お知らせ・機能フラグの取得に使用。anonキーのみでRLSによりSELECT以外は許可されない
NEXT_PUBLIC_INFRA_SUPABASE_URL=
NEXT_PUBLIC_INFRA_SUPABASE_ANON_KEY=
